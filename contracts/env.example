# Network RPC URLs
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR-PROJECT-ID
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR-PROJECT-ID

# 0G Galileo testnet (chainId 16602) - primary deployment target
OG_RPC_URL=https://evmrpc-testnet.0g.ai
# 0G Chain Scan needs no key; leave blank unless one is issued to you
OG_CHAINSCAN_API_KEY=

# Private key for deployment (keep secret!)
PRIVATE_KEY=your_private_key_here

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Gas reporting
REPORT_GAS=true
