{
  "name": "credora-frontend",
  "version": "1.0.0",
  "description": "Credora app — wallet UI and API layer for Galileo credit intelligence",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p api-lib/tsconfig.emit.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json",
    "test:api": "npx --yes tsx --test api-lib/riskSchema.test.ts api-lib/scoring.test.ts api-lib/compute.test.ts api-lib/analysis.test.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.8",
    "@tanstack/react-query": "^5.85.6",
    "clsx": "^2.1.1",
    "ethers": "^6.8.1",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.8.1",
    "viem": "^2.36.0",
    "wagmi": "^2.16.9",
    "zod": "^4.5.4",
    "@vercel/node": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.14",
    "dotenv": "^17.4.2",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^7.1.3"
  },
  "author": "Credora Team",
  "license": "MIT"
}
