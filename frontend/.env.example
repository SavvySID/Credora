# ---------------------------------------------------------------------------
# Browser-public values (safe to ship). Prefix VITE_ so Vite exposes them.
# Copy to .env.local
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=/api
# Leave blank on Vercel until the indexer has a public https URL.
VITE_INDEXER_STREAM_URL=
VITE_LOAN_CONTRACT_ADDRESS=0x994463b7c46889bF640fFc79f6B1368f9374e6A2
# Deployed Galileo Loan.sol (accounting-only; does not disburse principal).
VITE_0G_CHAIN_ID=16602
VITE_0G_EXPLORER_URL=https://chainscan-galileo.0g.ai
VITE_WALLETCONNECT_PROJECT_ID=61504cb93d71213589068e461ce421ad

# ---------------------------------------------------------------------------
# Server-only values for the local/Vercel API layer.
# NEVER prefix these with VITE_ - they must not reach the browser bundle.
# Used by Vite's /api middleware in `npm run dev` and by Vercel in production.
# ---------------------------------------------------------------------------

INDEXER_URL=http://localhost:3200
# On Vercel, leave INDEXER_URL unset (or set a public https URL). localhost will not work.
# Must match indexer/.env INDEXER_SHARED_SECRET
INDEXER_SHARED_SECRET=
INDEXER_TIMEOUT_MS=20000

ZG_COMPUTE_ROUTER_URL=https://router-api.0g.ai/v1
# Create at https://pc.0g.ai → API Keys, permission: inference
ZG_COMPUTE_API_KEY=
# Model id from GET https://router-api.0g.ai/v1/models
ZG_COMPUTE_MODEL=
ZG_COMPUTE_TIMEOUT_MS=25000

OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
