# Credora indexer — copy to .env

INDEXER_PORT=3200
INDEXER_SHARED_SECRET=
INDEXER_CORS_ORIGINS=http://localhost:3100
# When the indexer is public, add the Vercel origin or EventSource from the live site is blocked:
# INDEXER_CORS_ORIGINS=http://localhost:3100,https://credora-frontend-puce.vercel.app

OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602
CONFIRMATIONS=5
LOG_BLOCK_RANGE=2000

# Existing Galileo Loan.sol — do not redeploy
LOAN_CONTRACT_ADDRESS=0x994463b7c46889bF640fFc79f6B1368f9374e6A2
LOAN_DEPLOY_BLOCK=52485479

OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# Galileo key funded from https://faucet.0g.ai — required for Storage writes
OG_STORAGE_PRIVATE_KEY=

CHAINSCAN_API_URL=https://chainscan-galileo.0g.ai/open/api
CHAINSCAN_API_KEY=
CHAINSCAN_BROWSER_URL=https://chainscan-galileo.0g.ai

DATABASE_PATH=./data/credora-index.db
WALLET_ACTIVITY_TTL_MS=60000
POLL_INTERVAL_MS=15000
WORKER_ENABLED=true
