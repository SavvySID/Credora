# ---------------------------------------------------------------------------
# Credora indexer worker - SERVER ONLY
# Nothing in this file is ever exposed to the browser.
# Copy to .env and fill in. Leave a value blank to keep that capability BLOCKED.
# ---------------------------------------------------------------------------

# --- 0G Chain (Galileo testnet) --------------------------------------------
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602
CONFIRMATIONS=5
LOG_BLOCK_RANGE=2000

# --- 0G Storage -------------------------------------------------------------
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# REQUIRED FOR WRITES. A 0G Galileo private key with a balance, because every
# 0G Storage upload pays an on-chain fee. Get testnet 0G at https://faucet.0g.ai
# Leave blank and all writes report BLOCKED instead of silently failing.
OG_STORAGE_PRIVATE_KEY=

OG_UPLOAD_TIMEOUT_MS=120000
OG_DOWNLOAD_TIMEOUT_MS=30000

# --- Loan.sol ---------------------------------------------------------------
# Populated by `npm run deploy:galileo` in contracts/. If left blank the worker
# falls back to contracts/deployments/galileo.json, and reports BLOCKED if that
# file is absent too.
# Loan.sol records accounting principal only. requestLoan's 0.5 0G msg.value is
# an origination deposit, not a disbursement. MIN_TX_COUNT uses owner-set
# setBorrowerTxCount, not the wallet nonce. Bootstrap with:
#   cd contracts && npm run bootstrap:tx-count
LOAN_CONTRACT_ADDRESS=
LOAN_DEPLOY_BLOCK=

# --- Wallet transaction history --------------------------------------------
CHAINSCAN_API_URL=https://chainscan-galileo.0g.ai/open/api
CHAINSCAN_BROWSER_URL=https://chainscan-galileo.0g.ai
# 0G Chain Scan does not currently require a key.
CHAINSCAN_API_KEY=
CHAINSCAN_PAGE_SIZE=100
CHAINSCAN_TIMEOUT_MS=15000

# --- Service ----------------------------------------------------------------
INDEXER_PORT=3200
# REQUIRED. Shared with the Credora API layer so only it can read the index.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INDEXER_SHARED_SECRET=
INDEXER_CORS_ORIGINS=http://localhost:3100

# --- Index / cache ----------------------------------------------------------
# Derived data only. Safe to delete; it rebuilds from chain + 0G Storage.
DATABASE_PATH=./data/credora-index.db
WALLET_ACTIVITY_TTL_MS=60000

# --- Worker -----------------------------------------------------------------
POLL_INTERVAL_MS=15000
WORKER_ENABLED=true
LOG_LEVEL=info
