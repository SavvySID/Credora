{
  "name": "credora",
  "version": "1.0.0",
  "description": "AI-powered decentralized lending dApp - Wave 1 MVP",
  "private": true,
  "workspaces": [
    "contracts",
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:contracts && npm run install:backend && npm run install:frontend",
    "install:contracts": "cd contracts && npm install",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:indexer": "cd indexer && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:indexer": "cd indexer && npm run dev",
    "preflight": "cd indexer && npm run preflight",
    "e2e:0g": "cd indexer && npm run e2e:0g",
    "e2e:loan": "cd indexer && npm run e2e:loan",
    "e2e:compute": "cd indexer && npm run e2e:compute",
    "test:indexer": "cd indexer && npm test",
    "test:api": "cd frontend && npm run test:api",
    "build:frontend": "cd frontend && npm run build",
    "build:contracts": "cd contracts && npm run compile",
    "test:contracts": "cd contracts && npm test",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview"
  },
  "keywords": [
    "ai",
    "defi",
    "lending",
    "ethereum",
    "solidity",
    "react",
    "nodejs",
    "credora"
  ],
  "author": "Credora Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
